  squadPlayers CricketSquadPlayer[]
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("sports_teams")
}

model Player {
  id           String   @id @default(uuid()) @db.Uuid
  teamId       String   @map("team_id") @db.Uuid
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name         String
  role         String   @default("Player")
  jerseyNumber Int?     @map("jersey_number")
  avatarUrl    String?  @map("avatar_url")
  squadPlayers CricketSquadPlayer[]
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("sports_players")
}

model Match {
  id            String            @id @default(uuid()) @db.Uuid
  sportId       String            @map("sport_id") @db.Uuid
  sport         Sport             @relation(fields: [sportId], references: [id], onDelete: Cascade)
  competitionId String            @map("competition_id") @db.Uuid
  competition   Competition       @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  seasonId      String?           @map("season_id") @db.Uuid
  season        Season?           @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  teamAId       String            @map("team_a_id") @db.Uuid
  teamA         Team              @relation("HomeTeamMatches", fields: [teamAId], references: [id])
  teamBId       String            @map("team_b_id") @db.Uuid
  teamB         Team              @relation("AwayTeamMatches", fields: [teamBId], references: [id])
  venue         String?
  matchType     String            @default("T20") @map("match_type")
  status        String            @default("UPCOMING") // UPCOMING, LIVE, COMPLETED, CANCELLED
  startTime     DateTime          @map("start_time")
  endTime       DateTime?         @map("end_time")
  resultSummary String?           @map("result_summary")
  winningTeamId String?           @map("winning_team_id")
  score         MatchScore?
  scorecard     Scorecard?
  commentaries  CommentaryEvent[]
  squadPlayers CricketSquadPlayer[]
  scoreSnapshots CricketScoreSnapshot[]
  cricketMarkets CricketMarket[]
  testBets       TestBet[]
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  @@index([sportId, status])
  @@index([competitionId])
  @@map("sports_matches")
}

model CricketMarketCategory {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique // all, main, quick, first_innings, overs, players, dismissal, odd_even, session
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("cricket_market_categories")
}

model CricketMarket {
  id                String                 @id @default(uuid()) @db.Uuid
  matchId           String                 @map("match_id") @db.Uuid
  match             Match                  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  categorySlug      String                 @default("main") @map("category_slug")
  providerMarketId  String?                @map("provider_market_id")
  name              String                 // e.g. "Match Winner", "Match Total Runs Odd/Even"
  marketType        String                 @map("market_type") // MATCH_WINNER, TOSS_WINNER, TOTAL_RUNS, OVER_RUNS, PLAYER_RUNS, DISMISSAL_METHOD, ODD_EVEN, SESSION_FANCY, EXCHANGE_BACK_LAY
  status            String                 @default("OPEN") // OPEN, SUSPENDED, CLOSED, SETTLED
  sourceType        String                 @default("STATISTICAL_MODEL") @map("source_type") // LIVE_PROVIDER, BOOKMAKER, EXCHANGE, DEVELOPMENT_MOCK, STATISTICAL_MODEL
  lineThreshold     Float?                 @map("line_threshold")
  isBackLay         Boolean                @default(false) @map("is_back_lay")
  sortOrder         Int                    @default(0) @map("sort_order")
  selections        CricketMarketSelection[]
  testBetSelections TestBetSelection[]
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  @@index([matchId, categorySlug])
  @@index([marketType])
  @@map("cricket_markets")
}

model CricketMarketSelection {
  id                  String             @id @default(uuid()) @db.Uuid
  marketId            String             @map("market_id") @db.Uuid
  market              CricketMarket      @relation(fields: [marketId], references: [id], onDelete: Cascade)
  providerSelectionId String?            @map("provider_selection_id")
  name                String             // e.g. "India", "West Indies", "Odd", "Even", "Over 175.5"
  backPrice           Decimal            @map("back_price") @db.Decimal(8, 2)
  layPrice            Decimal?           @map("lay_price") @db.Decimal(8, 2)
  backLiquidity       Decimal?           @map("back_liquidity") @db.Decimal(12, 2)
  layLiquidity        Decimal?           @map("lay_liquidity") @db.Decimal(12, 2)
  status              String             @default("ACTIVE") // ACTIVE, SUSPENDED, WON, LOST, VOID
  sortOrder           Int                @default(0) @map("sort_order")
  testBetSelections   TestBetSelection[]
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  @@index([marketId])
  @@map("cricket_market_selections")
}

model TestBet {
  id              String             @id @default(uuid()) @db.Uuid
  betReference    String             @unique @map("bet_reference")
  userId          String?            @map("user_id") @db.Uuid
  user            User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  matchId         String             @map("match_id") @db.Uuid
  match           Match              @relation(fields: [matchId], references: [id], onDelete: Cascade)
  totalStake      Decimal            @map("total_stake") @db.Decimal(16, 4)
  potentialReturn Decimal            @map("potential_return") @db.Decimal(16, 4)
  potentialProfit Decimal            @map("potential_profit") @db.Decimal(16, 4)
  status          String             @default("OPEN") // OPEN, WON, LOST, VOID, CANCELLED
  isTestMode      Boolean            @default(true) @map("is_test_mode")
  selections      TestBetSelection[]
  settlements     TestBetSettlement[]
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([matchId])
  @@map("test_bets")
}

model TestBetSelection {
  id               String                 @id @default(uuid()) @db.Uuid
  testBetId        String                 @map("test_bet_id") @db.Uuid
  testBet          TestBet                @relation(fields: [testBetId], references: [id], onDelete: Cascade)
  marketId         String                 @map("market_id") @db.Uuid
  market           CricketMarket          @relation(fields: [marketId], references: [id], onDelete: Cascade)
  selectionId      String                 @map("selection_id") @db.Uuid
  selection        CricketMarketSelection @relation(fields: [selectionId], references: [id], onDelete: Cascade)
  marketName       String                 @map("market_name")
  selectionName    String                 @map("selection_name")
  oddsAtPlacement  Decimal                @map("odds_at_placement") @db.Decimal(8, 2)
  stake            Decimal                @db.Decimal(16, 4)
  status           String                 @default("OPEN") // OPEN, WON, LOST, VOID
  createdAt        DateTime               @default(now()) @map("created_at")

  @@map("test_bet_selections")
}

model TestBetSettlement {
  id                String   @id @default(uuid()) @db.Uuid
  testBetId         String   @map("test_bet_id") @db.Uuid
  testBet           TestBet  @relation(fields: [testBetId], references: [id], onDelete: Cascade)
  resultSource      String   @default("CRICAPI_MATCH_INFO") @map("result_source")
  settledBy         String   @default("SYSTEM_AUTO") @map("settled_by")
  settlementSummary String   @map("settlement_summary")
  payoutAmount      Decimal  @default(0) @map("payout_amount") @db.Decimal(16, 4)
  settledAt         DateTime @default(now()) @map("settled_at")

  @@map("test_bet_settlements")
}


model MatchScore {
