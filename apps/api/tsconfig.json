{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "src",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": [
      "node"
    ],
    "paths": {
      "@gaming-platform/auth": [
        "../../packages/auth/dist/index.d.ts"
      ],
      "@gaming-platform/types": [
        "../../packages/types/dist/index.d.ts"
      ],
      "@gaming-platform/database": [
        "../../packages/database/dist/index.d.ts"
      ],
      "@prisma/client": [
        "../../packages/database/src/generated/client/index.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*"
  ]
}