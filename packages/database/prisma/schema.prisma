  slug         String        @unique
  name         String
  icon         String?
  sortOrder    Int           @default(0) @map("sort_order")
  isActive     Boolean       @default(true) @map("is_active")
  competitions Competition[]
  teams        Team[]
  matches      Match[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@map("sports")
}

model Competition {
  id        String   @id @default(uuid()) @db.Uuid
  sportId   String   @map("sport_id") @db.Uuid
  sport     Sport    @relation(fields: [sportId], references: [id], onDelete: Cascade)
  slug      String
  name      String
  country   String?
  logoUrl   String?  @map("logo_url")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  seasons   Season[]
  matches   Match[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([sportId])
  @@map("sports_competitions")
}

model Season {
  id            String      @id @default(uuid()) @db.Uuid
  competitionId String      @map("competition_id") @db.Uuid
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  name          String
  year          Int
  isActive      Boolean     @default(true) @map("is_active")
  matches       Match[]
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@map("sports_seasons")
}

model Team {
  id          String   @id @default(uuid()) @db.Uuid
  sportId     String   @map("sport_id") @db.Uuid
  sport       Sport    @relation(fields: [sportId], references: [id], onDelete: Cascade)
  name        String
  shortName   String   @map("short_name")
  flagCode    String?  @map("flag_code")
  logoUrl     String?  @map("logo_url")
  country     String?
  homeMatches Match[]  @relation("HomeTeamMatches")
  awayMatches Match[]  @relation("AwayTeamMatches")
