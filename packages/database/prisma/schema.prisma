generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLAYER
  DEVELOPER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum BetStatus {
  PENDING
  WON
  LOST
  CASHED_OUT
  REFUNDED
}

enum DepositStatus {
  PENDING
  VERIFIED
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSED
}

enum HiloChoice {
  UP
  DOWN
}

enum HiloResult {
  WIN
  LOSS
  PENDING
}

enum HiloStatus {
  PENDING
  COMPLETED
  CANCELLED
}


model User {
  id                      String                   @id @default(uuid()) @db.Uuid
  name                    String?
  email                   String                   @unique
  phone                   String?                  @unique
  passwordHash            String                   @map("password_hash")
  role                    Role                     @default(PLAYER)
  status                  UserStatus               @default(ACTIVE)
  kycStatus               String                   @default("pending") @map("kyc_status")
  referralCode            String                   @unique @map("referral_code")
  referredById            String?                  @map("referred_by_id") @db.Uuid
  referredBy              User?                    @relation("ReferralTree", fields: [referredById], references: [id])
  downlines               User[]                   @relation("ReferralTree")
  avatarUrl               String?                  @map("avatar_url")
  wallet                  Wallet?
  gameBets                GameBet[]
  depositRequests         DepositRequest[]
  approvedDeposits        DepositRequest[]         @relation("ApprovedByAdmin")
  rejectedDeposits        DepositRequest[]         @relation("RejectedByAdmin")
  withdrawals             Withdrawal[]
  bankAccounts            BankAccount[]
  dailyRewards            DailyReward[]
  jetBets                 JetBet[]
  crashBets               CrashBet[]
  andarBaharBets          AndarBaharBet[]
  minesGames              MinesGame[]
  parityBets              ParityBet[]
  spinBets                SpinBet[]
  diceBets                DiceBet[]
  pushparaniBets          PushparaniBet[]
  coinFlipBets            CoinFlipBet[]
  receivedCommissions     Commission[]             @relation("BeneficiaryUser")
  generatedCommissions    Commission[]             @relation("SourceUser")
  referralLinksAsReferrer Referral[]               @relation("ReferrerRelation")
  referralLinksAsReferee  Referral[]               @relation("RefereeRelation")
  merchantAssignments     MerchantAssignmentLog[]
  depositVerifications    DepositVerification[]
  notifications           Notification[]
  testBets                TestBet[]
  hiloRounds              HiloRound[]
  hiloBets                HiloBet[]
  tenantPlayers           TenantPlayer[]
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")

  @@map("users")
}

model Wallet {
  id                String              @id @default(uuid()) @db.Uuid
  userId            String              @unique @map("user_id") @db.Uuid
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  mainBalance       Decimal             @default(0.0000) @map("main_balance") @db.Decimal(16, 4)
  bonusBalance      Decimal             @default(0.0000) @map("bonus_balance") @db.Decimal(16, 4)
  commissionBalance Decimal             @default(0.0000) @map("commission_balance") @db.Decimal(16, 4)
  totalDeposited    Decimal             @default(0.0000) @map("total_deposited") @db.Decimal(16, 4)
  totalWinnings     Decimal             @default(0.0000) @map("total_winnings") @db.Decimal(16, 4)
  currency          String              @default("INR")
  status            String              @default("active")
  version           Int                 @default(1)
  transactions      WalletTransaction[]
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  @@map("wallets")
}

model WalletTransaction {
  id            String   @id @default(uuid()) @db.Uuid
  walletId      String   @map("wallet_id") @db.Uuid
  wallet        Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type          String
  amount        Decimal  @db.Decimal(16, 4)
  balanceBefore Decimal  @map("balance_before") @db.Decimal(16, 4)
  balanceAfter  Decimal  @map("balance_after") @db.Decimal(16, 4)
  referenceType String?  @map("reference_type")
  referenceId   String?  @map("reference_id")
  metadata      Json?    @default("{}")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([walletId])
  @@map("wallet_transactions")
}

model MerchantAccount {
  id                    String                  @id @default(uuid()) @db.Uuid
  name                  String
  accountHolder         String?                 @map("account_holder")
  upiId                 String?                 @map("upi_id")
  qrImage               String?                 @map("qr_image")
  bankName              String?                 @map("bank_name")
  accountNumber         String?                 @map("account_number")
  ifsc                  String?                 @map("ifsc")
  status                String                  @default("active")
  dailyLimit            Decimal                 @default(200000.00) @map("daily_limit") @db.Decimal(16, 4)
  currentDailyTotal     Decimal                 @default(0.00) @map("current_daily_total") @db.Decimal(16, 4)
  priority              Int                     @default(1)
  supportedPaymentTypes Json?                   @map("supported_payment_types")
  region                String                  @default("IN")
  currency              String                  @default("INR")
  depositRequests       DepositRequest[]
  assignmentLogs        MerchantAssignmentLog[]
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")

  @@map("merchant_accounts")
}

model DepositRequest {
  id                String                  @id @default(uuid()) @db.Uuid
  depositId         String                  @unique @map("deposit_id")
  userId            String                  @map("user_id") @db.Uuid
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchantAccountId String?                 @map("merchant_account_id") @db.Uuid
  merchantAccount   MerchantAccount?        @relation(fields: [merchantAccountId], references: [id], onDelete: SetNull)
  amount            Decimal                 @db.Decimal(16, 4)
  paymentMethod     String                  @default("upi") @map("payment_method")
  utrNumber         String?                 @map("utr_number")
  status            DepositStatus           @default(PENDING)
  userRemarks       String?                 @map("user_remarks")
  adminNotes        String?                 @map("admin_notes")
  approvedById      String?                 @map("approved_by_id") @db.Uuid
  approvedBy        User?                   @relation("ApprovedByAdmin", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectedById      String?                 @map("rejected_by_id") @db.Uuid
  rejectedBy        User?                   @relation("RejectedByAdmin", fields: [rejectedById], references: [id], onDelete: SetNull)
  approvedAt        DateTime?               @map("approved_at")
  rejectedAt        DateTime?               @map("rejected_at")
  expiresAt         DateTime?               @map("expires_at")
  proofs            DepositProof[]
  verifications     DepositVerification[]
  assignmentLogs    MerchantAssignmentLog[]
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  @@index([utrNumber])
  @@map("deposit_requests")
}

model DepositProof {
  id               String         @id @default(uuid()) @db.Uuid
  depositRequestId String         @map("deposit_request_id") @db.Uuid
  depositRequest   DepositRequest @relation(fields: [depositRequestId], references: [id], onDelete: Cascade)
  filePath         String         @map("file_path")
  fileType         String?        @map("file_type")
  originalName     String?        @map("original_name")
  uploadedAt       DateTime?      @map("uploaded_at")
  createdAt        DateTime       @default(now()) @map("created_at")

  @@map("deposit_proofs")
}

model DepositVerification {
  id               String         @id @default(uuid()) @db.Uuid
  depositRequestId String         @map("deposit_request_id") @db.Uuid
  depositRequest   DepositRequest @relation(fields: [depositRequestId], references: [id], onDelete: Cascade)
  adminId          String?        @map("admin_id") @db.Uuid
  admin            User?          @relation(fields: [adminId], references: [id], onDelete: SetNull)
  statusFrom       String         @map("status_from")
  statusTo         String         @map("status_to")
  verificationNotes String?       @map("verification_notes")
  verifiedAt       DateTime       @map("verified_at")
  createdAt        DateTime       @default(now()) @map("created_at")

  @@map("deposit_verifications")
}

model MerchantAssignmentLog {
  id                String          @id @default(uuid()) @db.Uuid
  depositRequestId  String          @map("deposit_request_id") @db.Uuid
  depositRequest    DepositRequest  @relation(fields: [depositRequestId], references: [id], onDelete: Cascade)
  merchantAccountId String          @map("merchant_account_id") @db.Uuid
  merchantAccount   MerchantAccount @relation(fields: [merchantAccountId], references: [id], onDelete: Cascade)
  userId            String          @map("user_id") @db.Uuid
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount            Decimal         @db.Decimal(16, 4)
  assignmentReason  String?         @map("assignment_reason")
  assignedAt        DateTime        @map("assigned_at")
  createdAt         DateTime        @default(now()) @map("created_at")

  @@map("merchant_assignment_logs")
}

model BankAccount {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  user          User         @relation(fields: [userId], references: [id])
  holderName    String       @map("holder_name")
  upiId         String?      @map("upi_id")
  bankName      String?      @map("bank_name")
  accountNumber String?      @map("account_number")
  ifscCode      String?      @map("ifsc_code")
  status        String       @default("pending")
  isPrimary     Boolean      @default(true) @map("is_primary")
  withdrawals   Withdrawal[]
  createdAt     DateTime     @default(now()) @map("created_at")

  @@map("bank_accounts")
}

model Withdrawal {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  user            User             @relation(fields: [userId], references: [id])
  bankAccountId   String?          @map("bank_account_id") @db.Uuid
  bankAccount     BankAccount?     @relation(fields: [bankAccountId], references: [id])
  amount          Decimal          @db.Decimal(16, 4)
  fee             Decimal          @default(0.00) @db.Decimal(16, 4)
  netAmount       Decimal          @map("net_amount") @db.Decimal(16, 4)
  status          WithdrawalStatus @default(PENDING)
  rejectionReason String?          @map("rejection_reason")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@map("withdrawals")
}

model Referral {
  id                   String   @id @default(uuid()) @db.Uuid
  referrerId           String   @map("referrer_id") @db.Uuid
  referrer             User     @relation("ReferrerRelation", fields: [referrerId], references: [id], onDelete: Cascade)
  refereeId            String   @map("referee_id") @db.Uuid
  referee              User     @relation("RefereeRelation", fields: [refereeId], references: [id], onDelete: Cascade)
  level                Int      @default(1)
  totalCommissionEarned Decimal  @default(0.00) @map("total_commission_earned") @db.Decimal(16, 4)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("referrals")
}

model Commission {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  user           User      @relation("BeneficiaryUser", fields: [userId], references: [id], onDelete: Cascade)
  sourceUserId   String    @map("source_user_id") @db.Uuid
  sourceUser     User      @relation("SourceUser", fields: [sourceUserId], references: [id], onDelete: Cascade)
  betId          String?   @map("bet_id") @db.Uuid
  bet            GameBet?  @relation(fields: [betId], references: [id], onDelete: Cascade)
  level          Int
  amount         Decimal   @db.Decimal(16, 4)
  ratePercentage Decimal   @map("rate_percentage") @db.Decimal(5, 2)
  status         String    @default("credited")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("commissions")
}

model DailyReward {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  dayIndex  Int      @map("day_index")
  amount    Decimal  @db.Decimal(16, 4)
  claimedAt DateTime @default(now()) @map("claimed_at")

  @@map("daily_rewards")
}

model Coupon {
  id         String    @id @default(uuid()) @db.Uuid
  code       String    @unique
  reward     Decimal   @db.Decimal(16, 4)
  maxUses    Int       @default(100) @map("max_uses")
  usedCount  Int       @default(0) @map("used_count")
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("coupons")
}

model Game {
  id            String      @id @default(uuid()) @db.Uuid
  slug          String      @unique
  name          String
  category      String
  engine        String      @default("phaser3")
  rtpPercentage Decimal     @default(95.00) @map("rtp_percentage") @db.Decimal(5, 2)
  minBet        Decimal     @default(10.00) @map("min_bet") @db.Decimal(12, 2)
  maxBet        Decimal     @default(10000.00) @map("max_bet") @db.Decimal(12, 2)
  isActive      Boolean     @default(true) @map("is_active")
  manifest      Json        @default("{}")
  gameBets      GameBet[]
  createdAt     DateTime    @default(now()) @map("created_at")

  @@map("games")
}

model GameBet {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  user         User         @relation(fields: [userId], references: [id])
  gameId       String       @map("game_id") @db.Uuid
  game         Game         @relation(fields: [gameId], references: [id])
  periodNumber String?      @map("period_number")
  betAmount    Decimal      @map("bet_amount") @db.Decimal(16, 4)
  betType      String?      @map("bet_type")
  multiplier   Decimal      @default(0.00) @db.Decimal(10, 2)
  winAmount    Decimal      @default(0.00) @map("win_amount") @db.Decimal(16, 4)
  status       BetStatus    @default(PENDING)
  betDetails   Json?        @default("{}") @map("bet_details")
  gameMoves    GameMove[]
  commissions  Commission[]
  createdAt    DateTime     @default(now()) @map("created_at")

  @@map("game_bets")
}

model GameMove {
  id          String   @id @default(uuid()) @db.Uuid
  gameBetId   String   @map("game_bet_id") @db.Uuid
  gameBet     GameBet  @relation(fields: [gameBetId], references: [id], onDelete: Cascade)
  tileIndex   Int      @map("tile_index")
  isMine      Boolean  @default(false) @map("is_mine")
  multiplier  Decimal  @default(1.00) @db.Decimal(10, 2)
  profit      Decimal  @default(0.00) @db.Decimal(16, 4)
  clickedAt   DateTime @default(now()) @map("clicked_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("game_moves")
}

model JetRound {
  id              String   @id @default(uuid()) @db.Uuid
  roundNumber     BigInt   @unique @map("round_number")
  crashMultiplier Decimal  @map("crash_multiplier") @db.Decimal(10, 2)
  status          String   @default("COMPLETED")
  bets            JetBet[]
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("jet_rounds")
}

model JetBet {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  user         User      @relation(fields: [userId], references: [id])
  roundId      String    @map("round_id") @db.Uuid
  round        JetRound  @relation(fields: [roundId], references: [id])
  amount       Decimal   @db.Decimal(16, 4)
  multiplier   Decimal   @default(0.00) @db.Decimal(10, 2)
  payout       Decimal   @default(0.00) @db.Decimal(16, 4)
  status       BetStatus @default(PENDING)
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("jet_bets")
}

model CrashRound {
  id              String     @id @default(uuid()) @db.Uuid
  roundNumber     BigInt     @unique @map("round_number")
  crashMultiplier Decimal    @map("crash_multiplier") @db.Decimal(10, 2)
  status          String     @default("COMPLETED")
  bets            CrashBet[]
  createdAt       DateTime   @default(now()) @map("created_at")

  @@map("crash_rounds")
}

model CrashBet {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  user         User       @relation(fields: [userId], references: [id])
  roundId      String     @map("round_id") @db.Uuid
  round        CrashRound @relation(fields: [roundId], references: [id])
  amount       Decimal    @db.Decimal(16, 4)
  multiplier   Decimal    @default(0.00) @db.Decimal(10, 2)
  payout       Decimal    @default(0.00) @db.Decimal(16, 4)
  status       BetStatus  @default(PENDING)
  createdAt    DateTime   @default(now()) @map("created_at")

  @@map("crash_bets")
}

model AndarBaharRound {
  id           String          @id @default(uuid()) @db.Uuid
  roundNumber  BigInt          @unique @map("round_number")
  jokerCard    String          @map("joker_card")
  winningSide  String          @map("winning_side")
  cardsDealt   Json            @default("[]") @map("cards_dealt")
  bets         AndarBaharBet[]
  createdAt    DateTime        @default(now()) @map("created_at")

  @@map("andar_bahar_rounds")
}

model AndarBaharBet {
  id           String          @id @default(uuid()) @db.Uuid
  userId       String          @map("user_id") @db.Uuid
  user         User            @relation(fields: [userId], references: [id])
  roundId      String          @map("round_id") @db.Uuid
  round        AndarBaharRound @relation(fields: [roundId], references: [id])
  side         String
  amount       Decimal         @db.Decimal(16, 4)
  payout       Decimal         @default(0.00) @db.Decimal(16, 4)
  status       BetStatus       @default(PENDING)
  createdAt    DateTime        @default(now()) @map("created_at")

  @@map("andar_bahar_bets")
}

model MinesGame {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  user          User      @relation(fields: [userId], references: [id])
  betAmount     Decimal   @map("bet_amount") @db.Decimal(16, 4)
  mineCount     Int       @map("mine_count")
  minePositions Json      @map("mine_positions")
  revealedTiles Json      @default("[]") @map("revealed_tiles")
  multiplier    Decimal   @default(1.00) @db.Decimal(10, 2)
  payout        Decimal   @default(0.00) @db.Decimal(16, 4)
  status        BetStatus @default(PENDING)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("mines_games")
}

model ParityPeriod {
  id           String      @id @default(uuid()) @db.Uuid
  periodId     String      @unique @map("period_id")
  gameType     String      @default("FAST_PARITY") @map("game_type")
  resultNumber Int         @map("result_number")
  resultColor  String      @map("result_color")
  bets         ParityBet[]
  createdAt    DateTime    @default(now()) @map("created_at")

  @@map("parity_periods")
}

model ParityBet {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  user         User         @relation(fields: [userId], references: [id])
  periodId     String       @map("period_id")
  period       ParityPeriod @relation(fields: [periodId], references: [periodId])
  selectOption String       @map("select_option")
  amount       Decimal      @db.Decimal(16, 4)
  payout       Decimal      @default(0.00) @db.Decimal(16, 4)
  status       BetStatus    @default(PENDING)
  createdAt    DateTime     @default(now()) @map("created_at")

  @@map("parity_bets")
}

model SpinBet {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  user          User      @relation(fields: [userId], references: [id])
  selectedColor String    @map("selected_color")
  resultColor   String    @map("result_color")
  betAmount     Decimal   @map("bet_amount") @db.Decimal(16, 4)
  multiplier    Decimal   @default(0.00) @db.Decimal(10, 2)
  payoutAmount  Decimal   @default(0.00) @map("payout_amount") @db.Decimal(16, 4)
  status        BetStatus @default(PENDING)
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("spin_bets")
}

model DiceBet {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  user         User      @relation(fields: [userId], references: [id])
  targetNumber Int       @map("target_number")
  rollType     String    @map("roll_type")
  rolledNumber Int       @map("rolled_number")
  betAmount    Decimal   @map("bet_amount") @db.Decimal(16, 4)
  multiplier   Decimal   @default(0.00) @db.Decimal(10, 2)
  payoutAmount Decimal   @default(0.00) @map("payout_amount") @db.Decimal(16, 4)
  status       BetStatus @default(PENDING)
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("dice_bets")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifications")
}

model PushparaniRound {
  id              String          @id @default(uuid()) @db.Uuid
  roundNumber     BigInt          @unique @map("round_number")
  crashMultiplier Decimal         @map("crash_multiplier") @db.Decimal(10, 2)
  status          String          @default("COMPLETED")
  bets            PushparaniBet[]
  createdAt       DateTime        @default(now()) @map("created_at")

  @@map("pushparani_rounds")
}

model PushparaniBet {
  id           String          @id @default(uuid()) @db.Uuid
  userId       String          @map("user_id") @db.Uuid
  user         User            @relation(fields: [userId], references: [id])
  roundId      String          @map("round_id") @db.Uuid
  round        PushparaniRound @relation(fields: [roundId], references: [id])
  amount       Decimal         @db.Decimal(16, 4)
  multiplier   Decimal         @default(0.00) @db.Decimal(10, 2)
  payout       Decimal         @default(0.00) @db.Decimal(16, 4)
  status       BetStatus       @default(PENDING)
  createdAt    DateTime        @default(now()) @map("created_at")

  @@map("pushparani_bets")
}

model CoinFlipBet {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  chosenSide   String    @map("chosen_side")
  resultSide   String    @map("result_side")
  betAmount    Decimal   @map("bet_amount") @db.Decimal(16, 4)
  multiplier   Decimal   @default(1.96) @db.Decimal(10, 2)
  payoutAmount Decimal   @default(0.00) @map("payout_amount") @db.Decimal(16, 4)
  status       BetStatus @default(PENDING)
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("coin_flip_bets")
}

model HiloRound {
  id            String      @id @default(uuid()) @db.Uuid
  roundId       String      @unique @map("round_id")
  userId        String      @map("user_id") @db.Uuid
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentCard   String      @map("current_card")
  currentRank   Int         @map("current_rank")
  currentSuit   String      @map("current_suit")
  playerChoice  HiloChoice? @map("player_choice")
  betAmount     Decimal     @map("bet_amount") @db.Decimal(16, 4)
  nextCard      String?     @map("next_card")
  nextRank      Int?        @map("next_rank")
  nextSuit      String?     @map("next_suit")
  result        HiloResult  @default(PENDING)
  profit        Decimal     @default(0.00) @db.Decimal(16, 4)
  payout        Decimal     @default(0.00) @db.Decimal(16, 4)
  balanceBefore Decimal     @map("balance_before") @db.Decimal(16, 4)
  balanceAfter  Decimal?    @map("balance_after") @db.Decimal(16, 4)
  status        HiloStatus  @default(PENDING)
  createdAt     DateTime    @default(now()) @map("created_at")
  completedAt   DateTime?   @map("completed_at")

  bets          HiloBet[]

  @@index([userId])
  @@index([roundId])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("hilo_rounds")
}

model HiloBet {
  id        String     @id @default(uuid()) @db.Uuid
  roundId   String     @map("round_id") @db.Uuid
  round     HiloRound  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  userId    String     @map("user_id") @db.Uuid
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  betAmount Decimal    @map("bet_amount") @db.Decimal(16, 4)
  choice    HiloChoice
  status    BetStatus  @default(PENDING)
  createdAt DateTime   @default(now()) @map("created_at")

  @@index([userId])
  @@index([roundId])
  @@index([createdAt])
  @@map("hilo_bets")
}


// ─────────────────────────────────────────────
// SPORTS PLATFORM MODELS
// ─────────────────────────────────────────────

model Sport {
