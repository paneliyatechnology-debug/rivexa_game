// ─────────────────────────────────────────────
// MULTI-TENANT WHITE-LABEL PLATFORM MODELS
// ─────────────────────────────────────────────

enum TenantStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum TenantMemberRole {
  SUPER_ADMIN
  SUB_ADMIN
  SUPER_AGENT
  AGENT
}

enum TenantMemberStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

/// A white-label tenant / operator
model Tenant {
  id                String           @id @default(uuid()) @db.Uuid
  slug              String           @unique
  name              String
  domain            String?          @unique
  logoUrl           String?          @map("logo_url")
  primaryColor      String           @default("#6366f1") @map("primary_color")
  status            TenantStatus     @default(ACTIVE)
  /// JSON map of commission rates per level: { super_admin, sub_admin, super_agent, agent }
  commissionRates   Json             @default("{}") @map("commission_rates")
  maxAgentCount     Int              @default(50) @map("max_agent_count")
  maxPlayerCount    Int              @default(5000) @map("max_player_count")
  /// Array of game slugs allowed for this tenant
  allowedGames      Json             @default("[]") @map("allowed_games")
  members           TenantMember[]
  players           TenantPlayer[]
  creditLogs        TenantCreditLog[]
  auditLogs         TenantAuditLog[]
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  @@map("tenants")
}

/// Tenant staff: SUPER_ADMIN → SUB_ADMIN → SUPER_AGENT → AGENT (hierarchy via parentId)
model TenantMember {
  id                 String             @id @default(uuid()) @db.Uuid
  tenantId           String             @map("tenant_id") @db.Uuid
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parentId           String?            @map("parent_id") @db.Uuid
  parent             TenantMember?      @relation("MemberHierarchy", fields: [parentId], references: [id])
  children           TenantMember[]     @relation("MemberHierarchy")
  name               String
  email              String
  phone              String?
  passwordHash       String             @map("password_hash")
  role               TenantMemberRole
  status             TenantMemberStatus @default(ACTIVE)
  creditBalance      Decimal            @default(0) @map("credit_balance") @db.Decimal(16, 4)
  commissionBalance  Decimal            @default(0) @map("commission_balance") @db.Decimal(16, 4)
  referralCode       String             @unique @map("referral_code")
  metadata           Json               @default("{}")
  players            TenantPlayer[]     @relation("AssignedAgent")
  creditLogsGiven    TenantCreditLog[]  @relation("CreditGiver")
  creditLogsReceived TenantCreditLog[]  @relation("CreditReceiver")
  auditLogs          TenantAuditLog[]   @relation("MemberAuditLogs")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  @@unique([tenantId, email])
  @@index([tenantId, role])
  @@index([parentId])
  @@map("tenant_members")
}

/// Links an existing platform User (player) to a tenant and optionally to an agent
model TenantPlayer {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String       @map("user_id") @db.Uuid
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId   String?      @map("agent_id") @db.Uuid
  agent     TenantMember? @relation("AssignedAgent", fields: [agentId], references: [id])
  createdAt DateTime     @default(now()) @map("created_at")

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([agentId])
  @@map("tenant_players")
}

/// Ledger of credit transfers between tenant members (downward) or commission credits (upward)
model TenantCreditLog {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  giverId       String?       @map("giver_id") @db.Uuid
  giver         TenantMember? @relation("CreditGiver", fields: [giverId], references: [id])
  receiverId    String        @map("receiver_id") @db.Uuid
  receiver      TenantMember  @relation("CreditReceiver", fields: [receiverId], references: [id])
  amount        Decimal       @db.Decimal(16, 4)
  type          String        // CREDIT, DEBIT, COMMISSION
  description   String?
  balanceBefore Decimal       @map("balance_before") @db.Decimal(16, 4)
  balanceAfter  Decimal       @map("balance_after") @db.Decimal(16, 4)
  createdAt     DateTime      @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([receiverId])
  @@map("tenant_credit_logs")
}

/// Immutable audit trail for all tenant actions
model TenantAuditLog {
  id         String        @id @default(uuid()) @db.Uuid
  tenantId   String?       @map("tenant_id") @db.Uuid
  tenant     Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId   String?       @map("member_id") @db.Uuid
  member     TenantMember? @relation("MemberAuditLogs", fields: [memberId], references: [id])
  action     String        // e.g. CREATE_AGENT, UPDATE_PLAYER, TOGGLE_STATUS, TRANSFER_CREDIT
  entityType String        @map("entity_type") // TENANT, MEMBER, PLAYER, CREDIT
  entityId   String?       @map("entity_id")
  oldValues  Json?         @map("old_values")
  newValues  Json?         @map("new_values")
  ipAddress  String?       @map("ip_address")
  userAgent  String?       @map("user_agent")
  createdAt  DateTime      @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([memberId])
  @@map("tenant_audit_logs")
}

// ==========================================
// CHICKEN ROAD GAME MODELS
// ==========================================

enum ChickenRoadStatus {
  CREATED
  READY
  RUNNING
  CASHED_OUT
  CRASHED
  COMPLETED
  EXPIRED
  CANCELLED
}

enum ChickenRoadResultState {
  PENDING
  WIN
  LOSS
  CASHOUT
  EXPIRED
}

model ChickenRoadRound {
  id                      String                  @id @default(uuid()) @db.Uuid
  publicId                String                  @unique @default(uuid()) @map("public_id")
  userId                  String                  @map("user_id") @db.Uuid
  user                    User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  difficultyId            String                  @map("difficulty_id")
  currency                String                  @default("INR")
  betAmount               Decimal                 @map("bet_amount") @db.Decimal(20, 8)
  currentCheckpoint       Int                     @default(0) @map("current_checkpoint")
  currentMultiplier       Decimal                 @default(1.00) @map("current_multiplier") @db.Decimal(12, 6)
  potentialPayout         Decimal                 @default(0.00) @map("potential_payout") @db.Decimal(20, 8)
  status                  ChickenRoadStatus       @default(CREATED)
  result                  ChickenRoadResultState  @default(PENDING)
  serverSeedHash          String                  @map("server_seed_hash")
  serverSeed              String                  @map("server_seed")
  clientSeed              String                  @map("client_seed")
  nonce                   Int                     @default(1)
  difficultyConfigVersion Int                     @default(1) @map("difficulty_config_version")
  startedAt               DateTime?               @map("started_at")
  endedAt                 DateTime?               @map("ended_at")
  cashoutAt               DateTime?               @map("cashout_at")
  createdAt               DateTime                @default(now()) @map("created_at")
  updatedAt               DateTime                @updatedAt @map("updated_at")

  checkpoints             ChickenRoadCheckpoint[]
  actions                 ChickenRoadAction[]
  gameResult              ChickenRoadResult?

  @@index([userId])
  @@index([publicId])
  @@index([status])
  @@index([createdAt])
  @@map("chicken_road_rounds")
}

model ChickenRoadCheckpoint {
  id                 String           @id @default(uuid()) @db.Uuid
  gameRoundId        String           @map("game_round_id") @db.Uuid
  gameRound          ChickenRoadRound @relation(fields: [gameRoundId], references: [id], onDelete: Cascade)
  checkpointNumber   Int              @map("checkpoint_number")
  multiplier         Decimal          @db.Decimal(12, 6)
  result             String           // SAFE or CRASH
  randomValue        Decimal          @map("random_value") @db.Decimal(12, 8)
  trafficPatternId   String?          @map("traffic_pattern_id")
  createdAt          DateTime         @default(now()) @map("created_at")

  @@index([gameRoundId])
  @@map("chicken_road_checkpoints")
}

model ChickenRoadAction {
  id           String           @id @default(uuid()) @db.Uuid
  gameRoundId  String           @map("game_round_id") @db.Uuid
  gameRound    ChickenRoadRound @relation(fields: [gameRoundId], references: [id], onDelete: Cascade)
  userId       String           @map("user_id") @db.Uuid
  action       String           // CREATE_ROUND, START, MOVE, CASHOUT, RECOVER, CANCEL
  checkpoint   Int              @default(0)
  requestId    String           @map("request_id")
  payload      Json?
  response     Json?
  createdAt    DateTime         @default(now()) @map("created_at")

  @@index([gameRoundId])
  @@index([userId])
  @@map("chicken_road_actions")
}

model ChickenRoadResult {
  id              String           @id @default(uuid()) @db.Uuid
  gameRoundId     String           @unique @map("game_round_id") @db.Uuid
  gameRound       ChickenRoadRound @relation(fields: [gameRoundId], references: [id], onDelete: Cascade)
  userId          String           @map("user_id") @db.Uuid
  betAmount       Decimal          @map("bet_amount") @db.Decimal(20, 8)
  finalCheckpoint Int              @map("final_checkpoint")
  finalMultiplier Decimal          @map("final_multiplier") @db.Decimal(12, 6)
  grossPayout     Decimal          @map("gross_payout") @db.Decimal(20, 8)
  profit          Decimal          @db.Decimal(20, 8)
  currency        String           @default("INR")
  result          String           // WIN or LOSS
  createdAt       DateTime         @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt])
  @@map("chicken_road_results")
}

model ChickenRoadDifficulty {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  slug             String   @unique // easy, medium, hard, hardcore
  description      String
  safeProbability  Float    @map("safe_probability")
  multiplierConfig Json     @map("multiplier_config")
  maxMultiplier    Decimal  @map("max_multiplier") @db.Decimal(12, 6)
  enabled          Boolean  @default(true)
  sortOrder        Int      @default(0) @map("sort_order")
  version          Int      @default(1)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("chicken_road_difficulties")
}

model ChickenRoadTrafficPattern {
  id             String   @id @default(uuid()) @db.Uuid
  difficultyId   String?  @map("difficulty_id")
  name           String
  laneCount      Int      @default(25) @map("lane_count")
  speedMin       Float    @default(1.0) @map("speed_min")
  speedMax       Float    @default(3.0) @map("speed_max")
  vehicleDensity Float    @default(0.5) @map("vehicle_density")
  patternData    Json     @map("pattern_data")
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("chicken_road_traffic_patterns")
}

model ChickenRoadSettings {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       Json
  type        String   @default("string")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("chicken_road_settings")
}

model ChickenRoadAuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id")
  adminId    String?  @map("admin_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("chicken_road_audit_logs")
}

model GameProvider {
  id           String        @id @default(uuid()) @db.Uuid
  slug         String        @unique
  name         String
  isEnabled    Boolean       @default(true) @map("is_enabled")
  capabilities Json          @default("{}")
  config       Json          @default("{}")
  gameSessions GameSession[]
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  @@map("game_providers")
}

model GameSession {
  id                 String            @id @default(uuid()) @db.Uuid
  userId             String            @map("user_id") @db.Uuid
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId             String            @map("game_id") @db.Uuid
  game               Game              @relation(fields: [gameId], references: [id], onDelete: Cascade)
  tokenHash          String            @map("token_hash")
  providerId         String?           @map("provider_id") @db.Uuid
  provider           GameProvider?     @relation(fields: [providerId], references: [id], onDelete: SetNull)
  providerSessionId  String?           @map("provider_session_id")
  status             GameSessionStatus @default(CREATED)
  mode               String            @default("REAL")
  currency           String            @default("INR")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz
  expiresAt          DateTime          @map("expires_at") @db.Timestamptz
  absoluteExpiresAt  DateTime          @map("absolute_expires_at") @db.Timestamptz
  lastActivityAt     DateTime?         @map("last_activity_at") @db.Timestamptz
  closedAt           DateTime?         @map("closed_at") @db.Timestamptz
  revokedAt          DateTime?         @map("revoked_at") @db.Timestamptz
  revocationReason   String?           @map("revocation_reason")
  metadata           Json              @default("{}")
  events             GameSessionEvent[]

  @@index([userId])
  @@index([gameId])
  @@index([status])
  @@index([expiresAt])
  @@index([tokenHash])
  @@index([providerSessionId])
  @@map("game_sessions")
}

model GameSessionEvent {
  id        String      @id @default(uuid()) @db.Uuid
  sessionId String      @map("session_id") @db.Uuid
  session   GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  eventType String      @map("event_type")
  payload   Json        @default("{}")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz

  @@index([sessionId])
  @@index([eventType])
  @@map("game_session_events")
}

// ==========================================
// PENALTY SHOOTOUT / NATIONS CUP MODELS
// ==========================================

enum PenaltyStatus {
  CREATED
  ACTIVE
  CASHED_OUT
  SAVED
  COMPLETED
  CANCELLED
}

enum PenaltyResultState {
  PENDING
  WIN
  LOSS
  CASHOUT
}

model PenaltyShootoutRound {
  id                String             @id @default(uuid()) @db.Uuid
  publicId          String             @unique @default(uuid()) @map("public_id")
  userId            String             @map("user_id") @db.Uuid
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  difficulty        String             @default("MEDIUM") // EASY, MEDIUM, HARD, HARDCORE
  currency          String             @default("INR")
  betAmount         Decimal            @map("bet_amount") @db.Decimal(20, 8)
  currentStep       Int                @default(0) @map("current_step")
  currentMultiplier Decimal            @default(1.00) @map("current_multiplier") @db.Decimal(12, 6)
  potentialPayout   Decimal            @default(0.00) @map("potential_payout") @db.Decimal(20, 8)
  status            PenaltyStatus      @default(CREATED)
  result            PenaltyResultState @default(PENDING)
  serverSeedHash    String             @map("server_seed_hash")
  serverSeed        String             @map("server_seed")
  clientSeed        String             @map("client_seed")
  nonce             Int                @default(1)
  homeTeam          String             @default("South Africa") @map("home_team")
  awayTeam          String             @default("Japan") @map("away_team")
  startedAt         DateTime?          @map("started_at")
  endedAt           DateTime?          @map("ended_at")
  cashoutAt         DateTime?          @map("cashout_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  shots             PenaltyShot[]
  gameResult        PenaltyResult?

  @@index([userId])
  @@index([publicId])
  @@index([status])
  @@index([createdAt])
  @@map("penalty_shootout_rounds")
}

model PenaltyShot {
  id           String               @id @default(uuid()) @db.Uuid
  gameRoundId  String               @map("game_round_id") @db.Uuid
  gameRound    PenaltyShootoutRound @relation(fields: [gameRoundId], references: [id], onDelete: Cascade)
  shotNumber   Int                  @map("shot_number")
  targetSpot   Int                  @map("target_spot") // 1: TL, 2: TR, 3: C, 4: BL, 5: BR
  keeperSpot   Int                  @map("keeper_spot") // 1 to 5
  result       String               // GOAL or SAVED
  multiplier   Decimal              @db.Decimal(12, 6)
  randomValue  Decimal              @map("random_value") @db.Decimal(12, 8)
  createdAt    DateTime             @default(now()) @map("created_at")

  @@index([gameRoundId])
  @@map("penalty_shots")
}

model PenaltyResult {
  id              String               @id @default(uuid()) @db.Uuid
  gameRoundId     String               @unique @map("game_round_id") @db.Uuid
  gameRound       PenaltyShootoutRound @relation(fields: [gameRoundId], references: [id], onDelete: Cascade)
  userId          String               @map("user_id") @db.Uuid
  betAmount       Decimal              @map("bet_amount") @db.Decimal(20, 8)
  finalStep       Int                  @map("final_step")
  finalMultiplier Decimal              @map("final_multiplier") @db.Decimal(12, 6)
  grossPayout     Decimal              @map("gross_payout") @db.Decimal(20, 8)
  profit          Decimal              @db.Decimal(20, 8)
  currency        String               @default("INR")
  result          String               // WIN or LOSS
  createdAt       DateTime             @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt])
  @@map("penalty_results")
}




