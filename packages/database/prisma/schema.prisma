}

model CricketMarket {
  id                String                 @id @default(uuid()) @db.Uuid
  matchId           String                 @map("match_id") @db.Uuid
  match             Match                  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  categorySlug      String                 @default("main") @map("category_slug")
  providerMarketId  String?                @map("provider_market_id")
  name              String                 // e.g. "Match Winner", "Match Total Runs Odd/Even"
  marketType        String                 @map("market_type") // MATCH_WINNER, TOSS_WINNER, TOTAL_RUNS, OVER_RUNS, PLAYER_RUNS, DISMISSAL_METHOD, ODD_EVEN, SESSION_FANCY, EXCHANGE_BACK_LAY
  status            String                 @default("OPEN") // OPEN, SUSPENDED, CLOSED, SETTLED, VOID, CANCELLED, EXPIRED
  suspendReason     String?                @map("suspend_reason")
  sourceType        String                 @default("STATISTICAL_MODEL") @map("source_type") // LIVE_PROVIDER, BOOKMAKER, EXCHANGE, DEVELOPMENT_MOCK, STATISTICAL_MODEL
  lineThreshold     Float?                 @map("line_threshold")
  isBackLay         Boolean                @default(false) @map("is_back_lay")
  sortOrder         Int                    @default(0) @map("sort_order")
  margin            Decimal                @default(0.04) @db.Decimal(6, 4)
  tenantId          String?                @map("tenant_id") @db.Uuid
  configurationId   String?                @map("configuration_id")
  version           Int                    @default(1)
  sequence          Int                    @default(1)
  openedAt          DateTime?              @map("opened_at")
  suspendedAt       DateTime?              @map("suspended_at")
  closedAt          DateTime?              @map("closed_at")
  settledAt         DateTime?              @map("settled_at")
  expiresAt         DateTime?              @map("expires_at")
  selections        CricketMarketSelection[]
  testBetSelections TestBetSelection[]
  priceSnapshots    MarketPriceSnapshot[]
  exposureSnapshots MarketExposureSnapshot[]
  events            MarketEvent[]
  overrides         MarketOverride[]
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  @@index([matchId, categorySlug])
  @@index([marketType])
  @@index([tenantId])
  @@map("cricket_markets")
}

