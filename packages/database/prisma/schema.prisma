}

model CommentaryEvent {
  id          String   @id @default(uuid()) @db.Uuid
  matchId     String   @map("match_id") @db.Uuid
  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  overNumber  Float    @map("over_number")
  ballNumber  Int      @map("ball_number")
  runs        Int      @default(0)
  event       String   @default("RUN") // FOUR, SIX, WICKET, DOT, SINGLE, WIDE, NO_BALL
  bowler      String
  batsman     String
  description String
  timestamp   DateTime @default(now())

  @@index([matchId])
  @@map("sports_commentary_events")
}

model SportsProviderConfig {
  id           String    @id @default(uuid()) @db.Uuid
  providerName String    @default("MockSportsProvider") @map("provider_name")
  isActive     Boolean   @default(true) @map("is_active")
  autoSync     Boolean   @default(true) @map("auto_sync")
  syncInterval Int       @default(5) @map("sync_interval")
  lastSyncAt   DateTime? @map("last_sync_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

